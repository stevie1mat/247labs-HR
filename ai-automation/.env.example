# ─── AI Automation Server Environment ────────────────────────────────────────
# Copy this file to .env and fill in the values

# Supabase (required)
SUPABASE_URL=https://xbfhtdgqiioignjgrsjy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AI Provider: "groq" or "anthropic"
AI_PROVIDER=groq

# Groq (if using Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.2-90b-vision-preview

# Anthropic (if using Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# API Key to protect this server (set the same key in your Supabase edge function)
AUTOMATION_API_KEY=your_secret_api_key_here

# Server port
PORT=8000
