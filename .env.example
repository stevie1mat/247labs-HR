# Database Configuration
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# Supabase Authentication Keys (Frontend & Backend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# OpenAI Configuration
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Optional AI fallback if OpenAI fails
GROQ_API_KEY="gsk_..."
GROQ_MODEL="llama-3.1-8b-instant"

# JWT Encryption Secret (used for encrypting posting source credentials in DB)
JWT_SECRET="super-secret-key-32-bytes-long!!"

# Zoho Recruit Configuration
ZOHO_CLIENT_ID="your_zoho_client_id"
ZOHO_CLIENT_SECRET="your_zoho_client_secret"
ZOHO_REFRESH_TOKEN="your_zoho_refresh_token"
